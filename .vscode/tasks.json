{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SignSpeak: install frontend",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "SignSpeak: start dev server",
      "type": "shell",
      "command": "npm ci && npm run dev -- --host 127.0.0.1 --port 43123",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
